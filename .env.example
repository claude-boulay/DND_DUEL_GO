# Copier ce fichier en `.env` à la racine : `cp .env.example .env`
# Docker Compose lit automatiquement le .env de la racine.

# --- Ports exposés sur la machine hôte ---
FRONTEND_PORT=5173
BACKEND_PORT=3000
MONGO_PORT=27017

# --- Base de données ---
MONGO_DB=yugioh_dnd

# --- Authentification ---
# CHANGER impérativement avant toute mise en ligne.
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- API externe ---
YGOPRODECK_API_URL=https://db.ygoprodeck.com/api/v7

# --- Envoi d'email (mot de passe oublié) ---
# Tous optionnels : si SMTP_HOST est vide, le code de réinitialisation part
# en console du backend au lieu d'un vrai email (pratique en dev local sans
# compte SMTP réel). Renseignez ces variables pour un vrai envoi (ex. un
# compte Gmail avec mot de passe d'application, SendGrid, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Images de prod (production uniquement, voir docker-compose.prod.yml) ---
# Tag des images backend/frontend tirées de GHCR (voir .github/workflows/ci.yml).
# "latest" = toujours la dernière publiée sur main ; un SHA de commit précis
# (ex. a1b2c3d) fige une version pour rollback/reproductibilité.
IMAGE_TAG=latest

# --- Authentification MongoDB (production uniquement, voir docker-compose.prod.yml) ---
# Le dev tourne sans identifiants (mongo local, jamais exposé hors du réseau
# Docker) ; en prod, ces deux variables créent un utilisateur root MongoDB. Ne
# prend effet qu'au TOUT PREMIER démarrage sur un volume `mongo_data` VIDE —
# l'image officielle Mongo ne crée cet utilisateur que si /data/db est encore
# vide, donc sans effet si vous avez déjà lancé la stack prod sans ça avant
# (volume déjà peuplé). Évitez les caractères spéciaux d'URI (@ : / # ?) dans
# le mot de passe : ils ne sont pas échappés dans MONGO_URI.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=

# --- Reverse proxy TLS (production uniquement, voir docker-compose.prod.yml + Caddyfile) ---
# Domaine public pointé (enregistrement DNS A/AAAA) vers ce serveur — Caddy
# obtient et renouvelle automatiquement un certificat Let's Encrypt pour ce
# nom. Laisser "localhost" tant qu'aucun domaine n'est configuré : Caddy
# utilise alors un certificat auto-signé (utilisable en local/test), la stack
# prod reste donc lançable sans domaine.
CADDY_DOMAIN=localhost
