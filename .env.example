# Copier ce fichier en `.env` à la racine : `cp .env.example .env`
# Docker Compose lit automatiquement le .env de la racine.

# --- Ports exposés sur la machine hôte ---
FRONTEND_PORT=5173
BACKEND_PORT=3000
MONGO_PORT=27017

# --- Base de données ---
MONGO_DB=yugioh_dnd

# --- Authentification ---
# CHANGER impérativement avant toute mise en ligne.
JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- API externe ---
YGOPRODECK_API_URL=https://db.ygoprodeck.com/api/v7

# --- Envoi d'email (mot de passe oublié) ---
# Tous optionnels : si SMTP_HOST est vide, le code de réinitialisation part
# en console du backend au lieu d'un vrai email (pratique en dev local sans
# compte SMTP réel). Renseignez ces variables pour un vrai envoi (ex. un
# compte Gmail avec mot de passe d'application, SendGrid, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
